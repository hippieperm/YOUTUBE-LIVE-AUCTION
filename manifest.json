{
  "manifest_version": 3,
  "name": "해담분재경매 관리",
  "version": "2.5.2",
  "description": "YouTube 라이브 경매의 낙찰 처리, 안내 패널, 낙찰 내역 및 엑셀 다운로드를 자동화합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "해담분재경매 관리",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "file:///*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat_replay*",
        "https://youtube.com/live_chat_replay*"
      ],
      "js": ["youtube-live-auction.user.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
